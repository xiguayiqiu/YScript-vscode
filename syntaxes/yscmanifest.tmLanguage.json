{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "YScript Manifest",
  "scopeName": "source.yscmanifest",
  "patterns": [
    {
      "name": "comment.line.number-sign.yscmanifest",
      "match": "^\\s*#.*$"
    },
    {
      "name": "keyword.control.yscmanifest",
      "match": "^\\s*(models|res|dep)\\b"
    },
    {
      "name": "constant.other.h1.yscmanifest",
      "match": "\\bh1:[A-Za-z0-9+/]+={0,2}"
    },
    {
      "name": "punctuation.separator.key-value.yscmanifest",
      "match": ":|\\[|\\]"
    },
    {
      "name": "string.quoted.double.yscmanifest",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.yscmanifest",
          "match": "\\\\."
        }
      ]
    }
  ]
}
