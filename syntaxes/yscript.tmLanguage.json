{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "YScript",
  "scopeName": "source.yscript",
  "fileTypes": [
    "ys",
    "yscript"
  ],
  "firstLineMatch": "^#!",
  "patterns": [
    {
      "include": "#preprocessor"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#bytes-literal"
    },
    {
      "include": "#interp-string"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#regexp-literal"
    },
    {
      "include": "#shell-command"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#test-operators"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "identifier": {
      "match": "[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.other.yscript"
    },
    "identifiers": {
      "patterns": [
        {
          "include": "#identifier"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "keyword.control.preprocessor.condition.yscript",
          "match": "^\\s*#(if|elif|else|endif)\\b"
        },
        {
          "name": "keyword.control.preprocessor.permit.yscript",
          "match": "^\\s*#!?permit\\b"
        },
        {
          "name": "keyword.control.preprocessor.yscript",
          "match": "^\\s*#[!]?[A-Za-z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.yscript",
          "begin": "#\\*",
          "end": "\\*#",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.yscript"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.yscript"
            }
          }
        },
        {
          "name": "comment.line.number-sign.yscript",
          "match": "#.*$"
        }
      ]
    },
    "bytes-literal": {
      "name": "string.quoted.bytes.yscript",
      "begin": "\\bb\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.bytes-prefix.yscript"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.yscript",
          "match": "\\\\([abfnrtv\\\\\"'0]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[0-7]{1,3})"
        },
        {
          "name": "keyword.control.bytes-prefix.yscript",
          "match": "\\bbase64:"
        }
      ]
    },
    "interp-string": {
      "name": "string.quoted.double.interp.yscript",
      "begin": "\\$\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.interp-prefix.yscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.yscript"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.yscript",
          "match": "\\\\([abfnrtv\\\\\"'\\$0]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
        },
        {
          "name": "variable.interpolation.yscript",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.begin.yscript"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.end.yscript"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            },
            {
              "include": "#builtins"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#identifiers"
            }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.yscript",
      "begin": "(?<!b)\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.yscript",
          "match": "\\\\([abfnrtv\\\\\"'\\?0]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[0-7]{1,3})"
        }
      ]
    },
    "regexp-literal": {
      "name": "string.regexp.yscript",
      "begin": "(?<![A-Za-z0-9_)\\]\"'}:]\\s*)/(?![/*])",
      "end": "/([imsU]*)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.regexp.begin.yscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.regexp.end.yscript"
        },
        "1": {
          "name": "keyword.other.regexp-flags.yscript"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.yscript",
          "match": "\\\\."
        }
      ]
    },
    "shell-command": {
      "name": "string.interpolated.command.yscript",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.command.begin.yscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.command.end.yscript"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.yscript",
          "match": "\\\\`"
        },
        {
          "name": "variable.interpolation.yscript",
          "match": "\\$\\{[^}]*\\}"
        },
        {
          "include": "#shell-command-content"
        }
      ]
    },
    "shell-command-content": {
      "patterns": [
        {
          "name": "variable.shell.yscript",
          "match": "\\$\\([^)]*\\)"
        },
        {
          "name": "variable.shell.yscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "support.function.shell.yscript",
          "match": "(?<![A-Za-z0-9_\\-])(nc|nmap|curl|wget|python|python3|ping|bash|sh|ssh|scp|sed|awk|grep|cat|ls|cd|echo|mkdir|rm|chmod|chown|tar|gzip|unzip|xxd|hexdump|base64|openssl|iptables|netstat|ss|ifconfig|ip|nslookup|dig|host|traceroute|whois|hydra|sqlmap|gobuster|dirb|nikto|wpscan|aircrack|john|hashcat|powershell|cmd|reg|systeminfo|hostname|ipconfig|arp|route|tracert|find|xargs|tee|sort|uniq|wc|head|tail|strings|objdump|readelf|ltrace|strace|tcpdump|msfconsole|msfvenom|searchsploit|responder|bettercap)(?![A-Za-z0-9_\\-])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.yscript",
          "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b|\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.yscript",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.octal.yscript",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.binary.yscript",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.integer.yscript",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.yscript",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.nil.yscript",
          "match": "\\b(?:nil|nan|inf)\\b"
        },
        {
          "name": "constant.language.global.yscript",
          "match": "\\b(?:LAST_EXIT_CODE|__FILE__|__LINE__|__FUNC__|OS|ARCH|VERSION|ENV)\\b"
        },
        {
          "name": "constant.language.error.yscript",
          "match": "\\b(?:ErrOK|ErrGeneral|ErrTimeout|ErrCanceled|ErrPermission|ErrNotFound|ErrExists|ErrInvalidArg|ErrNotSupported|ErrNetGeneral|ErrNetTimeout|ErrNetRefused|ErrNetUnreach|ErrNetReset|ErrNetDNS|ErrNetTLS|ErrIOGeneral|ErrIORead|ErrIOWrite|ErrIOEOF|ErrIODiskFull|ErrIOPermission)\\b"
        }
      ]
    },
    "test-operators": {
      "name": "keyword.operator.test.yscript",
      "match": "(?<![A-Za-z0-9_\\-])-(e|f|d|r|w|x|s|L|h|b|c|p|S|u|g|k|z|n|nt|ot|ef|eq|ne|gt|lt|ge|le|a|o)(?![A-Za-z0-9_\\-])|--\\w+"
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.yscript",
          "match": "\\b(func)\\s+(this\\.)?([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "keyword.declaration.yscript"
            },
            "2": {
              "name": "keyword.other.unit.yscript"
            },
            "3": {
              "name": "entity.name.function.yscript"
            }
          }
        },
        {
          "name": "meta.type.yscript",
          "match": "\\b(struct|interface|enum|class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.yscript"
            },
            "2": {
              "name": "entity.name.type.yscript"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.yscript",
          "match": "\\b(?:if|else|elif|switch|case|default|match|for|while|loop|in|range|break|continue|goto|return|yield|defer)\\b"
        },
        {
          "name": "keyword.control.import.yscript",
          "match": "\\b(?:import|package|as|using|namespace)\\b"
        },
        {
          "name": "keyword.declaration.yscript",
          "match": "\\b(?:let|const|var|func|init|main|struct|enum|interface|class|map|warp|do)\\b"
        },
        {
          "name": "keyword.operator.logical.yscript",
          "match": "\\b(?:and|or|not|xor)\\b"
        },
        {
          "name": "keyword.operator.comparison.yscript",
          "match": "\\b(?:matches|is)\\b"
        },
        {
          "name": "keyword.control.exception.yscript",
          "match": "\\b(?:try|catch|finally|raise|panic|recover|assert)\\b"
        },
        {
          "name": "keyword.other.unit.yscript",
          "match": "\\b(?:this|self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.yscript",
          "match": "\\b(?:byte|char|short|ushort|int|uint|long|ulong|float|double|bool|string|bytes|list|dict|ipv4|ipv6|error|any|void)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.yscript",
          "match": "\\b(?:print|println|printf|sprintf|len|type|hex|eval|next|panic|recover|assert)\\b"
        },
        {
          "name": "constant.other.builtin.yscript",
          "match": "\\b(?:time\\.DAY|time\\.HOUR|time\\.MINUTE|time\\.SECOND|time\\.MILLISECOND|time\\.RFC3339|binary\\.EOF|io\\.EOF|io\\.Stdin|io\\.Stdout|io\\.Stderr)\\b"
