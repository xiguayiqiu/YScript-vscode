        {
          "name": "support.function.method.yscript",
          "match": "(?<=\\.)(?:compare_and_swap|wait_timeout|is_multicast|split_lines|trim_suffix|replace_all|try_acquire|is_loopback|trim_prefix|is_private|last_index|capitalize|has_prefix|has_suffix|pad_right|is_global|broadcast|to_base64|truncate|pad_left|contains|find_all|is_empty|expanded|prepend|version|recover|sprintf|matches|reverse|release|acquire|sort_by|println|to_utf8|replace|runlock|reduce|append|printf|values|detach|assert|unique|signal|delete|remove|double|string|to_hex|submit|unlink|filter|repeat|unlock|living|insert|chunk|store|lower|items|await|bytes|panic|merge|hosts|count|split|ulong|rlock|first|clear|index|upper|empty|close|print|float|size|last|lock|uint|join|ipv6|hush|long|load|link|next|stop|keys|eval|done|bool|type|trim|snap|wait|swap|ipv4|flat|send|recv|find|sort|copy|add|set|cap|int|len|map|sub|has|pop|hex|del|get)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.yscript",
          "match": "(\\|>|=>|\\?\\.|\\?\\?)"
        },
        {
          "name": "keyword.operator.yscript",
          "match": "(?:\\.\\.\\.?|->|<-|@>|@|::)"
        },
        {
          "name": "keyword.operator.ternary.yscript",
          "match": "\\?(?![.?])"
        },
        {
          "name": "keyword.operator.assignment.yscript",
          "match": "(<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=)"
        },
        {
          "name": "keyword.operator.comparison.yscript",
          "match": "(==|!=|<=|>=|<<|>>)"
        },
        {
          "name": "keyword.operator.bitwise.yscript",
          "match": "(\\&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.arithmetic.yscript",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.comparison.yscript",
          "match": "(?<!==)(?<!!=)(?<!<=)(?<!>=)(?<!=)(<|>)(?!=)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.yscript",
          "match": "[{}()\\[\\];,:]"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_]*)(:)(\\s*)$",
          "captures": {
            "2": {
              "name": "entity.name.label.yscript"
            },
            "3": {
              "name": "punctuation.definition.label.yscript"
            }
          }
        }
      ]
    }
  }
}
