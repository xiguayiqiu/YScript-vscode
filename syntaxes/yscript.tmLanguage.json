{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "YScript",
  "scopeName": "source.yscript",
  "fileTypes": ["ys", "yscript"],
  "firstLineMatch": "^#!/.*\\byscript\\b",
  "patterns": [
    { "include": "#comment" },
    { "include": "#bytes-literal" },
    { "include": "#shell-command" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#test-operators" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "identifier": {
      "match": "[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.other.yscript"
    },
    "identifiers": {
      "patterns": [
        { "include": "#identifier" }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.yscript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.yscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "shell-command": {
      "name": "string.interpolated.command.yscript",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.command.begin.yscript" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.command.end.yscript" }
      },
      "patterns": [
        { "include": "#shell-command-content" }
      ]
    },
    "shell-command-content": {
      "patterns": [
        {
          "name": "variable.shell.yscript",
          "match": "\\$\\([^)]*\\)"
        },
        {
          "name": "variable.shell.yscript",
          "match": "\\$\\{[^}]*\\}"
        },
        {
          "name": "variable.shell.yscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "support.function.shell.yscript",
          "match": "(?<![A-Za-z0-9_\\-])(nc|nmap|curl|wget|python|python3|ping|bash|sh|ssh|scp|sed|awk|grep|cat|ls|cd|echo|mkdir|rm|chmod|chown|tar|gzip|unzip|xxd|hexdump|base64|openssl|iptables|netstat|ss|ifconfig|ip|nslookup|dig|host|traceroute|whois|hydra|sqlmap|metasploit|msfconsole|john|hashcat|gobuster|dirb|nikto|wpscan|aircrack|aireplay|airmon|airodump|kismet|ettercap|burpsuite|hashcat|hash-identifier|binwalk|foremost|exiftool|steghide|volatility|gdb|objdump|readelf|strace|ltrace|ndisasm|radare2|ghidra|ida|socat|ncat|netcat|ssh-keygen|keytool|certutil|nc\\.exe|powershell|cmd|reg|systeminfo|whoami|hostname|ipconfig|arp|route|tracert|type|copy|del|attrib|takeown|icacls|bitsadmin|wevtutil)(?![A-Za-z0-9_\\-])"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.yscript",
      "begin": "(?<!b)\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.yscript",
          "match": "\\\\([abfnrtv\\\\\"'\\?0]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[0-7]{1,3})"
        }
      ]
    },
    "bytes-literal": {
      "name": "string.quoted.bytes.yscript",
      "begin": "\\bb\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "keyword.other.bytes-prefix.yscript" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.yscript",
          "match": "\\\\(x[0-9a-fA-F]{1,2}|[0-7]{1,3})"
        },
        {
          "name": "keyword.control.bytes-prefix.yscript",
          "match": "\\bbase64:"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.yscript",
          "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.hex.yscript",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.octal.yscript",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.binary.yscript",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.integer.yscript",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.yscript",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.yscript",
          "match": "\\b(nil|nan|inf)\\b"
        }
      ]
    },
    "test-operators": {
      "name": "keyword.operator.test.yscript",
      "match": "(?<![A-Za-z0-9_\\-])-(e|f|d|r|w|x|s|L|h|b|c|p|S|z|n|eq|ne|gt|lt|ge|le)(?![A-Za-z0-9_\\-])"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.yscript",
          "match": "(\\|>|&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.assignment.yscript",
          "match": "(<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=)"
        },
        {
          "name": "keyword.operator.comparison.yscript",
          "match": "(==|!=|<=|>=|<<|>>)"
        },
        {
          "name": "keyword.operator.bitwise.yscript",
          "match": "(\\&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.arithmetic.yscript",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.comparison.yscript",
          "match": "(?<!==)(?<!!=)(?<!<=)(?<!>=)(?<!=)(<|>)(?!=)"
        },
        {
          "name": "keyword.operator.yscript",
          "match": "(\\?\\.|\\.|\\?|@|::|=>)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.yscript",
          "match": "[{}()\\[\\];,|>]"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.yscript",
          "match": "\\b(if|else|elif|switch|case|default|for|while|loop|do|break|continue|return|yield|goto|try|catch|finally|raise|assert|defer|match)\\b"
        },
        {
          "name": "keyword.control.import.yscript",
          "match": "\\b(import|package|using|as|namespace|in|range)\\b"
        },
        {
          "name": "keyword.declaration.yscript",
          "match": "\\b(let|const|var|func|init|class|struct|enum|interface|warp)\\b"
        },
        {
          "name": "keyword.operator.logical.yscript",
          "match": "\\b(and|or|not|xor)\\b"
        },
        {
          "name": "keyword.operator.comparison.yscript",
          "match": "\\b(matches|is)\\b"
        },
        {
          "name": "keyword.other.unit.yscript",
          "match": "\\b(new|self|this)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.yscript",
          "match": "\\b(byte|char|short|ushort|int|uint|long|ulong|float|double|bool|string|bytes|list|dict|ipv4|ipv6|map|command|error|void)\\b"
        }
      ]
    }
  }
}
