{
  "package main": {
    "prefix": "pkgmain",
    "body": [
      "package main",
      "",
      "func main(args) {",
      "\t${0}",
      "\treturn 0",
      "}",
      ""
    ],
    "description": "package main + main(args) 入口；可执行逻辑写在函数体内"
  },
  "function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params}) {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "函数定义"
  },
  "function return": {
    "prefix": "funcr",
    "body": [
      "func ${1:name}(${2:params}) -> ${3:ret_type} {",
      "\treturn ${0}",
      "}",
      ""
    ],
    "description": "带返回值的函数"
  },
  "arrow function": {
    "prefix": "arrow",
    "body": [
      "(${1:params}) -> ${0:expr}"
    ],
    "description": "箭头函数简写"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:cond} {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "if 条件"
  },
  "if else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:cond} {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "if-else 条件"
  },
  "if elif else": {
    "prefix": "ifelif",
    "body": [
      "if ${1:cond1} {",
      "\t${2}",
      "} elif ${3:cond2} {",
      "\t${4}",
      "} else {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "if-elif-else 多分支"
  },
  "if test file": {
    "prefix": "ifile",
    "body": [
      "if -e \"${1:/path/to/file}\" {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "if -e 检查文件存在"
  },
  "if test dir": {
    "prefix": "idir",
    "body": [
      "if -d \"${1:/path/to/dir}\" {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "if -d 检查目录存在"
  },
  "for range": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "for 循环(范围)"
  },
  "for list": {
    "prefix": "forl",
    "body": [
      "for ${1:item} in ${2:list} {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "for 循环(列表)"
  },
  "for dict": {
    "prefix": "ford",
    "body": [
      "for ${1:k}, ${2:v} in ${3:dict} {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "for 循环(字典)"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:cond} {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "while 循环"
  },
  "loop": {
    "prefix": "loop",
    "body": [
      "loop {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "无限循环"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:val} {",
      "\t${2:pattern} => { ${3:body} }",
      "\t_ => { ${0:default} }",
      "}",
      ""
    ],
    "description": "match 模式匹配"
  },
  "defer": {
    "prefix": "defer",
    "body": [
      "defer func() {",
      "\t${0}",
      "}()",
      ""
    ],
    "description": "defer 延迟执行"
  },
  "defer recover": {
    "prefix": "drec",
    "body": [
      "defer func() {",
      "\tif r = recover(); r != nil {",
      "\t\tlog.error(\"崩溃恢复: {r}\")",
      "\t}",
      "}()",
      ""
    ],
    "description": "defer + recover 防止崩溃"
  },
  "warp": {
    "prefix": "warp",
    "body": [
      "let ${1:h} = warp {",
      "\t${0}",
      "}",
      "${1:h}.await()",
      ""
    ],
    "description": "启动并发 warp 线程"
  },
  "warp await": {
    "prefix": "wawait",
    "body": [
      "let ${1:h} = warp {",
      "\treturn ${2:result}",
      "}",
      "let ${3:result} = ${1:h}.await()",
      ""
    ],
    "description": "warp + await 取结果"
  },
  "shell command": {
    "prefix": "shell",
    "body": [
      "`${1:command}`"
    ],
    "description": "Shell 命令反引号"
  },
  "shell with var": {
    "prefix": "sv",
    "body": [
      "let ${1:result} = `${2:command}`"
    ],
    "description": "Shell 命令赋值给变量"
  },
  "bytes hex": {
    "prefix": "bx",
    "body": [
      "b\"\\\\x${1:90}\\\\x${2:cc}\""
    ],
    "description": "bytes 十六进制字面量"
  },
  "bytes base64": {
    "prefix": "b64",
    "body": [
      "b\"base64:${1:SGVsbG8=}\""
    ],
    "description": "bytes Base64 字面量"
  },
  "import": {
    "prefix": "imp",
    "body": [
      "import \"${1:string}\""
    ],
    "description": "import 导入单个标准库模块"
  },
  "import list": {
    "prefix": "impl",
    "body": [
      "import [",
      "\t\"${1:string}\",",
      "\t\"${2:io}\",",
      "]"
    ],
    "description": "import 方括号列表导入多个模块"
  },
  "import files": {
    "prefix": "impf",
    "body": [
      "import [",
      "\t\"${1:lib/util}\",",
      "]"
    ],
    "description": "import 方括号列表导入脚本文件 / 目录通配"
  },
  "struct": {
    "prefix": "st",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:type}",
      "}",
      ""
    ],
    "description": "结构体定义"
  },
  "struct method": {
    "prefix": "stm",
    "body": [
      "func this.${1:method}(${2:args}) {",
      "\t${0}",
      "}",
      ""
    ],
    "description": "结构体方法 (this.method)"
  },
  "enum": {
    "prefix": "en",
    "body": [
      "enum ${1:Name} {",
      "\t${2:A},",
      "\t${3:B},",
      "\t${4:C}",
      "}",
      ""
    ],
    "description": "枚举定义"
  },
  "interface": {
    "prefix": "iface",
    "body": [
      "interface ${1:Name} {",
      "\t${2:method}(${3:params})",
      "}",
      ""
    ],
    "description": "接口定义"
  },
  "let": {
    "prefix": "let",
    "body": [
      "let ${1:name} = ${0:value}"
    ],
    "description": "let 变量声明"
  },
  "inferred declaration": {
    "prefix": "infer",
    "body": [
      "${1:name} <- ${0:value}"
    ],
    "description": "<- 类型推断变量声明"
  },
  "let typed": {
    "prefix": "lett",
    "body": [
      "let ${1:name}: ${2:type} = ${0:value}"
    ],
    "description": "带类型注解的 let 声明"
  },
  "const": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${0:value}"
    ],
    "description": "const 常量声明"
  },
  "printf": {
    "prefix": "pf",
    "body": [
      "printf(\"${1:%s}\\\n\", ${0:args})"
    ],
    "description": "格式化输出"
  },
  "http get": {
    "prefix": "hget",
    "body": [
      "let ${1:resp} = http.Get(\"${2:url}\")",
      "if ${1:resp}.status == 200 {",
      "\tprintln(${1:resp}.status)",
      "\tprintln(${1:resp}.headers)",
      "\tprintln(${1:resp}.body)",
      "}",
      ""
    ],
    "description": "HTTP GET 请求"
  },
  "http raw": {
    "prefix": "hraw",
    "body": [
      "let ${1:resp} = http.Get(\"${2:url}\")",
      "println(${1:resp}.status)",
      "println(http.Headers(${1:resp}, \"content-type\"))",
      "println(${1:resp}.body)",
      "println(${1:resp}.raw)",
      ""
    ],
    "description": "HTTP 响应头/体/完整原始响应(类似Burp)"
  },
  "http session": {
    "prefix": "hsess",
    "body": [
      "let ${1:s} = http.Session({",
      "\t\"base_url\": \"${2:https://api.example.com}\",",
      "\t\"headers\": {\"Authorization\": \"Bearer ${3:token}\"},",
      "})",
      "let ${4:resp} = ${1:s}.get(\"${5:/path}\")",
      "if ${4:resp}.status == 200 {",
      "\tprintln(http.Json(${4:resp}))",
      "}",
      ""
    ],
    "description": "HTTP 会话（共享 Cookie / 默认头，链式调用）"
  },
  "http form": {
    "prefix": "hform",
    "body": [
      "let ${1:resp} = http.Form(\"${2:url}\", {\"${3:user}\": \"${4:admin}\"})",
      "println(${1:resp}.status)",
      ""
    ],
    "description": "HTTP 表单提交（自动 urlencoded 编码）"
  },
  "http upload": {
    "prefix": "hup",
    "body": [
      "let ${1:resp} = http.Upload(\"${2:url}\", {\"file\": \"${3:/tmp/a.png}\"}, {\"${4:note}\": \"${5:x}\"})",
      "println(${1:resp}.status)",
      ""
    ],
    "description": "HTTP multipart 文件上传"
  },
  "http download": {
    "prefix": "hdown",
    "body": [
      "let ${1:resp} = http.Download(\"${2:url}\", \"${3:/tmp/out.bin}\")",
      "if ${1:resp}.status == 200 {",
      "\tprintln(\"saved: \" + ${1:resp}.path + \" (\" + ${1:resp}.saved + \" bytes)\")",
      "}",
      ""
    ],
    "description": "HTTP 下载到文件"
  },
  "http server": {
    "prefix": "hsvr",
    "body": [
      "let ${1:srv} = http.Server(\":${2:8080}\", func(req) {",
      "\tif req.path == \"/${3:hello}\" {",
      "\t\treturn {",
      "\t\t\t\"status\": 200,",
      "\t\t\t\"headers\": {\"Content-Type\": \"application/json\"},",
      "\t\t\t\"body\": \"{\\\"ok\\\":true}\",",
      "\t\t}",
      "\t}",
      "\treturn {\"status\": 404, \"body\": \"not found\"}",
      "})",
      "println(\"listening on :${2:8080}\")",
      "# ${1:srv}.stop()",
      ""
    ],
    "description": "HTTP 本地服务：单文件路由 + 默认 404"
  },
  "http status code": {
    "prefix": "hsc",
    "body": "println(http.StatusCode(${1:404}))",
    "description": "HTTP 状态码释义（带分类与中文说明）"
  },
  "http retry backoff": {
    "prefix": "hback",
    "body": [
      "http.SetRetries(${1:3})",
      "http.SetRetryDelay(${2:0.5})",
      "http.SetRetryBackoff(\"${3:linear}\")  # exp | linear | constant"
    ],
    "description": "HTTP 重试退避策略（指数 / 线性 / 固定）"
  },
  "http after response": {
    "prefix": "hhk",
    "body": [
      "http.SetAfterResponse(func(resp) {",
      "\tlog.info(\"http: \" + str(resp.status) + \" \" + str(resp.url))",
      "\treturn resp",
      "})"
    ],
    "description": "HTTP 全局响应后钩子（打日志/二次加工）"
  },
  "port scan": {
    "prefix": "pscan",
    "body": [
      "for port in ${1:[22, 80, 443, 3306, 8080]} {",
      "\tlet conn = net.DialTimeout(\"${2:host}:\" + string(port), 2)",
      "\tif conn != nil {",
      "\t\tconn.close()",
      "\t\tprintln.green(\"[+] port \" + string(port) + \" open\")",
      "\t}",
      "}",
      ""
    ],
    "description": "端口扫描"
  },
  "shell port scan": {
    "prefix": "sscan",
    "body": [
      "for port in ${1:[22, 80, 443, 8080]} {",
      "\t`nc -z -w1 ${2:target} ` + string(port)",
      "\tif LAST_EXIT_CODE == 0 {",
      "\t\tprintln.green(\"[+] port \" + string(port) + \" open\")",
      "\t}",
      "}",
      ""
    ],
    "description": "Shell nc 端口扫描"
  },
  "comment": {
    "prefix": "#",
    "body": [
      "# ${0}"
    ],
    "description": "行注释 (#)"
  },
  "comment block": {
    "prefix": "#*",
    "body": [
      "#*",
      " * ${0}",
      " *#"
    ],
    "description": "块注释 (#* ... *#)"
  },
  "TODO": {
    "prefix": "todo",
    "body": [
      "# TODO: ${0}"
    ],
    "description": "TODO 注释"
  },
  "ternary": {
    "prefix": "tern",
    "description": "三元表达式",
    "body": [
      "${1:cond} ? ${2:a} : ${3:b}"
    ]
  },
  "multiret": {
    "prefix": "mret",
    "description": "多返回值",
    "body": [
      "func ${1:name}() {",
      "\treturn ${2:a}, ${3:b}",
      "}",
      "let ${4:x}, ${5:y} = ${1:name}()",
      ""
    ]
  },
  "wselect": {
    "prefix": "wsel",
    "description": "sync.select 通道选择",
    "body": [
      "let ${1:r} = sync.select(sync.case(${2:ch}, ${3:fn}))",
      ""
    ]
  },
  "struct with inheritance": {
    "prefix": "structext",
    "body": [
      "struct ${1:Child} extends ${2:Parent} {",
      "\t${3:field}: ${4:type}",
      "}",
      "",
      "# 重写父类方法；super.method() 复用父类实现",
      "func this.${5:method}() -> ${6:string} {",
      "\treturn super.${5:method}() + \"${0}\"",
      "}"
    ],
    "description": "继承 struct + 重写方法（super 调用）"
  },
  "slice expression": {
    "prefix": "slice",
    "body": "${1:list}[${2:start}:${3:end}${4::${5:step}}]",
    "description": "切片表达式 [start:end:step]（负下标/负步长可用）"
  },
  "socket tcp server": {
    "prefix": "stcp",
    "body": [
      "let srv = socket.Socket(\"tcp\")",
      "let port = srv.listen(${1:8080})",
      "let cli = srv.accept()",
      "cli.send(\"${2:hello}\\n\")",
      "println(binary.UTF8(cli.recv_line()))",
      "cli.close()",
      "srv.close()"
    ],
    "description": "socket TCP 服务端（listen/accept/send/recv_line）"
  },
  "socket tcp client": {
    "prefix": "stcpc",
    "body": [
      "let s = socket.Socket(\"tcp\")",
      "s.connect(\"${1:127.0.0.1}\", ${2:8080})",
      "s.send(\"${3:GET / HTTP/1.1\\r\\n\\r\\n}\")",
      "println(binary.UTF8(s.recv_all()))",
      "s.close()"
    ],
    "description": "socket TCP 客户端（connect/send/recv_all）"
  },
  "socket tcp request": {
    "prefix": "stcpreq",
    "body": "let resp = binary.UTF8(socket.tcp_request(\"${1:127.0.0.1}\", ${2:80}, \"${3:GET / HTTP/1.1\\r\\n\\r\\n}\"))",
    "description": "一行 TCP 请求便捷函数（服务端须主动关闭）"
  },
  "socket udp": {
    "prefix": "sudp",
    "body": [
      "let us = socket.Socket(\"udp\")",
      "let up = us.bind(\"0.0.0.0\", ${1:9000})",
      "let uc = socket.Socket(\"udp\")",
      "uc.connect_udp(\"127.0.0.1\", up)",
      "uc.send(\"${2:ping}\")",
      "let r = uc.recvfrom(${3:2048})",
      "println(binary.UTF8(r[0]))"
    ],
    "description": "socket UDP 请求/响应（须先 connect_udp 固定源端口）"
  },
  "socket typed catch": {
    "prefix": "scatch",
    "body": [
      "catch {",
      "\t${1:socket.Socket(\"tcp\").connect(${2:host}, ${3:port})}",
      "} match {",
      "\tConnectError(e) -> println(\"连接失败: \" + e)",
      "\tTimeoutError(e) -> println(\"超时: \" + e)",
      "\tTLSError(e)     -> println(\"TLS 失败: \" + e)",
      "\tSocketError(e)  -> println(\"其它: \" + e)",
      "\t_ -> println(\"未匹配\")",
      "}"
    ],
    "description": "按类型分流 socket 异常（带类型异常 match）"
  },
  "catch ensure": {
    "prefix": "cens",
    "body": [
      "catch {",
      "\t${1:do_something()}",
      "} ensure {",
      "\t${2:cleanup()}",
      "}"
    ],
    "description": "catch ... ensure 清理块（无论是否异常都执行）"
  },
  "catch fallback": {
    "prefix": "cfb",
    "body": "let ${1:n} = ${2:parse_int(\"abc\")} catch ${3:0}",
    "description": "单行兜底 expr catch 默认值"
  },
  "mutex": {
    "prefix": "mtx",
    "body": [
      "let m = sync.Mutex()",
      "m.lock()",
      "${0}",
      "m.unlock()"
    ],
    "description": "sync.Mutex 临界区（warp 协程间共享可变数据）"
  },
  "mutex try": {
    "prefix": "mtxt",
    "body": "if m.try_lock() { ${0} m.unlock() }",
    "description": "sync.Mutex 非阻塞加锁（抢不到返回 false）"
  },
  "c call": {
    "prefix": "c call",
    "body": [
      "let lib = c.compile_load(\"${1:mathx.c}\")",
      "let fn = c.bind(lib, \"${2:func}\", \"${3:int}\", [\"${4:int}\"])",
      "let r = c.call(fn, ${0:args})"
    ],
    "description": "编译并调用 C 函数"
  },
  "c callback": {
    "prefix": "c callback",
    "body": [
      "let cb = c.callback(${1:myFunc}, \"${2:int32}\", [\"${3:int32}\"])",
      "${0}",
      "c.callback_free(cb)"
    ],
    "description": "把 YScript 函数作为 C 回调传入"
  },
  "c header bind": {
    "prefix": "c header bind",
    "body": [
      "let lib = c.load(\"${1:/usr/lib/libc.so.6}\")",
      "let fn = c.header_bind(lib, \"${2:/usr/include/stdio.h}\", \"${3:snprintf}\")"
    ],
    "description": "从头文件自动取签名并绑定"
  },
  "c parse header": {
    "prefix": "c parse header",
    "body": [
      "let h = c.parse_header(\"${1:/usr/include/stdio.h}\")",
      "let sig = h.get(\"${2:printf}\")",
      "${0}"
    ],
    "description": "解析头文件获取函数签名"
  },
  "ffi struct call": {
    "prefix": "ffi struct",
    "body": [
      "let fn = c.bind(lib, \"${1:func}\", \"struct:${2:int32},${3:double}\", [])",
      "let r = c.call(fn, [${0:1}, 2.0])"
    ],
    "description": "结构体按值传参"
  },
  "ffi alloc": {
    "prefix": "ffi alloc",
    "body": [
      "let p = ffi.alloc(${1:64})",
      "${0}",
      "ffi.free(p)"
    ],
    "description": "分配并释放真实 C 内存"
  },
  "c variadic": {
    "prefix": "c variadic",
    "body": [
      "let snp = c.bind(libc, \"${1:snprintf}\", \"int\", [\"ptr\", \"ulong\", \"ptr\"], 3)",
      "let buf = ffi.alloc(128)",
      "c.call(snp, \"int\", [buf, 128, \"${2:%d items}\", ${3:42}])",
      "${0}",
      "ffi.free(buf)"
    ],
    "description": "变参函数调用（printf 一族）"
  },
  "raw pcap": {
    "prefix": "raw pcap",
    "body": [
      "let h = raw.PcapOpen(\"${1:eth0}\", ${2:false})",
      "while true {",
      "\tlet p = raw.PcapNext(h)",
      "\tif p == nil { break }",
      "\t${0}",
      "}"
    ],
    "description": "pcap 抓包循环"
  },
  "nginx static server": {
    "prefix": "nginx",
    "body": [
      "import [\"net\"]",
      "let ${1:srv} = net.nginx(\"${2:./public}\", \"${3::8080}\")",
      "println(\"http://127.0.0.1:\" + string(${1:srv}.port))",
      "${0}"
    ],
    "description": "静态目录 HTTP 服务"
  },
  "nginx TLS and access log": {
    "prefix": "nginxtls",
    "body": [
      "import [\"net\"]",
      "let ${1:opts} = {",
      "\t\"tls\": {\"cert\": \"${2:./server.crt}\", \"key\": \"${3:./server.key}\"},",
      "\t\"access_log\": true,",
      "\t\"access_log_file\": \"${4:./access.log}\"",
      "}",
      "let ${5:srv} = net.nginx(\"${6:./public}\", \"${7::8443}\", ${1:opts})",
      "println(\"https://127.0.0.1:\" + string(${5:srv}.port))",
      "${0}"
    ],
    "description": "静态目录 HTTPS 服务与访问日志"
  },
  "nginx PHP site": {
    "prefix": "nginxphp",
    "body": [
      "import [\"net\"]",
      "let ${1:opts} = {\"php_cgi\": \"${2:php-cgi}\"}",
      "let ${3:srv} = net.nginx(\"${4:./public}\", \"${5::8080}\", ${1:opts})",
      "println(\"http://127.0.0.1:\" + string(${3:srv}.port))",
      "${0}"
    ],
    "description": "启动支持 php-cgi 的 PHP 静态目录服务"
  },
